local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function dec(s)
    local out = {}; local buf, bits = 0, 0
    for i = 1, #s do
        local c = s:sub(i, i)
        if c == "=" then break end
        local v = B64:find(c, 1, true)
        if v then
            buf = buf * 64 + (v - 1); bits = bits + 6
            if bits >= 24 then
                bits = bits - 24
                out[#out + 1] = string.char(buf // (2 ^ (bits + 16)) % 256, buf // (2 ^ (bits + 8)) % 256, buf // (2 ^ bits) % 256)
                buf = buf % (2 ^ bits)
            end
        end
    end
    if bits == 12 then out[#out + 1] = string.char(buf // 16 % 256)
    elseif bits == 18 then out[#out + 1] = string.char(buf // 65536 % 256, buf // 256 % 256) end
    return table.concat(out)
end

local vm_src = dec("")
local payload_bytes = dec("")

print("[VM] vm:", #vm_src, "payload:", #payload_bytes)

-- Конвертируем payload в buffer
local ok, payload_buf = pcall(function() return buffer.fromstring(payload_bytes) end)
print("[VM] buffer.fromstring:", ok, type(payload_buf))

-- Ловим loadstring
local _ls = loadstring
loadstring = function(code, n, ...)
    if type(code) == "string" and #code > 50 then print("[VM] loadstring size=" .. #code) if writefile then writefile("vm_caught_" .. #code .. ".luau", code) end end
    return _ls(code, n, ...)
end

-- Компилируем VM
local fn, err = _ls(vm_src, "vm")
if not fn then print("[VM] compile fail:", err) return end
print("[VM] VM compiled")

-- Запускаем с buffer как первым аргументом
local target = ok and payload_buf or payload_bytes
local ok2, err2 = pcall(fn, target)
print("[VM] VM run:", ok2, err2)
